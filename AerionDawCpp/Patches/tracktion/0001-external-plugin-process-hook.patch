+    /// Called on the audio thread to run a hosted plugin's processBlock, or processBlockBypassed
+    /// when bypassed is true. Override to guard the call, e.g. to catch a crash inside the plugin.
+    /// (Aerion patch.)
+    virtual void processExternalPluginBlock (ExternalPlugin&, juce::AudioPluginInstance& instance,
+                                             juce::AudioBuffer<float>& buffer, juce::MidiBuffer& midi, bool bypassed)
+    {
+        if (bypassed)
+            instance.processBlockBypassed (buffer, midi);
+        else
+            instance.processBlock (buffer, midi);
+    }
